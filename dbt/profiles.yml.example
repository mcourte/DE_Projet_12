# Copier ce fichier en `profiles.yml` (ignoré par git) et l'adapter.
# DuckDB est un moteur embarqué : pas de serveur à démarrer, juste un fichier.

sport_data_solution:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: "../data/warehouse.duckdb"
      extensions:
        - parquet
        - postgres   # utilisé par export_gold_to_postgres pour écrire la couche gold
    # Utilisé par le workflow GitHub Actions (.github/workflows/dbt-ci.yml) :
    # fichier DuckDB jetable, alimenté par tests/fixtures/bronze, sans Postgres.
    ci:
      type: duckdb
      path: "../data/warehouse_ci.duckdb"
      extensions:
        - parquet
