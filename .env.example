# Copier ce fichier en `.env` (déjà exclu du repo par .gitignore) et
# remplir les valeurs réelles. Ne jamais committer le fichier .env.

# --- Slack ---
# cf. docs/RAPPORT.md pour la procédure de création de l'app Slack.
SLACK_BOT_TOKEN=xoxb-remplacer-par-le-vrai-token
SLACK_CHANNEL=#pratique-sportive

# --- Google Maps ---
# cf. docs/RAPPORT.md pour la procédure de création de la clé API.
GOOGLE_MAPS_API_KEY=remplacer-par-la-vraie-cle

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sportdata
POSTGRES_USER=sportdata
POSTGRES_PASSWORD=changeme

# --- NATS ---
NATS_URL=nats://localhost:4222
