# Copier ce fichier en `.env` (déjà exclu du repo par .gitignore) et
# remplir les valeurs réelles. Ne jamais committer le fichier .env.
# L'hôte, le port et la base PostgreSQL, l'adresse NATS et le channel Slack
# sont dans config/config.yaml : seuls les secrets vont ici.

# --- Slack (application de la mission, bot invité dans les channels) ---
SLACK_BOT_TOKEN=

# --- Google Maps (géocodage et distances domicile-bureau) ---
GOOGLE_MAPS_API_KEY=

# --- PostgreSQL (doit correspondre à docker-compose.yml) ---
POSTGRES_USER=sportdata
POSTGRES_PASSWORD=changeme

# --- Chiffrement des données RH (pgcrypto) : à garder en lieu sûr, sans elle
#     les colonnes chiffrées sont irrécupérables ---
PGCRYPTO_PASSPHRASE=
